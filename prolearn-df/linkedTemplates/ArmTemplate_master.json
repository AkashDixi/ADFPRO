{
	"$schema": "http://schema.management.azure.com/schemas/2015-01-01/deploymentTemplate.json#",
	"contentVersion": "1.0.0.0",
	"parameters": {
		"factoryName": {
			"type": "string",
			"metadata": "Data Factory name",
			"defaultValue": "prolearn-df"
		},
		"ls_DataLake_accountKey": {
			"type": "secureString",
			"metadata": "Secure string for 'accountKey' of 'ls_DataLake'"
		},
		"ls_SqlDatabase_password": {
			"type": "secureString",
			"metadata": "Secure string for 'password' of 'ls_SqlDatabase'"
		},
		"linked_service_RestAPI_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://pokeapi.co/api/v2/pokemon"
		},
		"ls_DataLake_properties_typeProperties_url": {
			"type": "string",
			"defaultValue": "https://storedf.dfs.core.windows.net/"
		},
		"ls_SqlDatabase_properties_typeProperties_server": {
			"type": "string",
			"defaultValue": "factserver.database.windows.net"
		},
		"ls_SqlDatabase_properties_typeProperties_database": {
			"type": "string",
			"defaultValue": "sql_learn"
		},
		"ls_SqlDatabase_properties_typeProperties_userName": {
			"type": "string",
			"defaultValue": "akadmin"
		},
		"containerUri": {
			"type": "string",
			"metadata": "URI to storage account containing linked ARM templates"
		},
		"containerSasToken": {
			"type": "string",
			"metadata": "Sas token to storage account containing linked ARM templates"
		}
	},
	"variables": {
		"factoryId": "[concat('Microsoft.DataFactory/factories/', parameters('factoryName'))]"
	},
	"resources": [
		{
			"name": "prolearn-df_ArmTemplate_0",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_0.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					},
					"ls_DataLake_accountKey": {
						"value": "[parameters('ls_DataLake_accountKey')]"
					},
					"ls_SqlDatabase_password": {
						"value": "[parameters('ls_SqlDatabase_password')]"
					},
					"linked_service_RestAPI_properties_typeProperties_url": {
						"value": "[parameters('linked_service_RestAPI_properties_typeProperties_url')]"
					},
					"ls_DataLake_properties_typeProperties_url": {
						"value": "[parameters('ls_DataLake_properties_typeProperties_url')]"
					},
					"ls_SqlDatabase_properties_typeProperties_server": {
						"value": "[parameters('ls_SqlDatabase_properties_typeProperties_server')]"
					},
					"ls_SqlDatabase_properties_typeProperties_database": {
						"value": "[parameters('ls_SqlDatabase_properties_typeProperties_database')]"
					},
					"ls_SqlDatabase_properties_typeProperties_userName": {
						"value": "[parameters('ls_SqlDatabase_properties_typeProperties_userName')]"
					}
				}
			},
			"dependsOn": []
		},
		{
			"name": "prolearn-df_ArmTemplate_1",
			"type": "Microsoft.Resources/deployments",
			"apiVersion": "2024-03-01",
			"properties": {
				"mode": "incremental",
				"templateLink": {
					"uri": "[concat(parameters('containerUri'), '/ArmTemplate_1.json', parameters('containerSasToken'))]",
					"contentVersion": "1.0.0.0"
				},
				"parameters": {
					"factoryName": {
						"value": "[parameters('factoryName')]"
					}
				}
			},
			"dependsOn": [
				"[resourceId('Microsoft.Resources/deployments', 'prolearn-df_ArmTemplate_0')]"
			]
		}
	]
}